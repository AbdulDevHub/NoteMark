{
  "name": "notemark",
  "productName": "NoteMark",
  "version": "2.0.0",
  "description": "A fast, local-first Markdown notes app for Windows, macOS and Linux. Your notes stay as plain .md files on your computer.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Abdul Khan",
    "url": "https://github.com/AbdulDevHub"
  },
  "license": "MIT",
  "homepage": "https://github.com/AbdulDevHub/NoteMark#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdulDevHub/NoteMark.git"
  },
  "bugs": {
    "url": "https://github.com/AbdulDevHub/NoteMark/issues"
  },
  "keywords": [
    "markdown",
    "markdown-editor",
    "notes",
    "note-taking",
    "notes-app",
    "local-first",
    "offline",
    "desktop-app",
    "electron",
    "react",
    "typescript",
    "wysiwyg"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm run lint:check && npm test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^1.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@mdxeditor/editor": "^3.55.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^22.10.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.1",
    "electron-vite": "^2.3.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "jotai": "^2.8.0",
    "marked": "^18.1.3",
    "postcss": "^8.4.38",
    "prettier": "^3.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^3.2.7"
  }
}
